rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Объявления правления (чтение всеми, создание, отметка о прочтении садоводом)
    match /announcements/{docId} {
      allow read: if true;
      allow create, update: if true;
      // Запрет на удаление через скрипты (защита от стирания ленты)
      allow delete: if false;
    }

    // 2. Информационный стенд, тарифы и телефоны
    match /config/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 3. Чат садоводов (публикация только текста до 1000 знаков, редактировать и удалять чужие посты нельзя)
    match /messages/{docId} {
      allow read: if true;
      allow create: if request.resource.data.text is string 
                    && request.resource.data.text.size() > 0 
                    && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    // 4. Реестр садоводов (регистрация и обновление статусов)
    match /residents/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // Защита аккаунтов от удаления
    }

    // Запрет доступа к любым непредусмотренным коллекциям
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

