rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Объявления правления (чтение всеми, создание, отметка о прочтении садоводом)
    match /announcements/{docId} {
      allow read: if true;
      allow create, update: if true;
      // Запрет на удаление через скрипты (защита от стирания ленты)
      allow delete: if false;
    }

    // 2. Информационный стенд, тарифы и телефоны
    match /config/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 3. Чат садоводов (чтение всеми, создание, реакции, редактирование и скрытие при удалении как в объявлениях)
    match /messages/{docId} {
      allow read: if true;
      allow create, update: if true;
      // Запрет на физическое удаление через скрипты (защита от стирания истории злоумышленниками), как в объявлениях
      allow delete: if false;
    }

    // 4. Реестр садоводов (регистрация, обновление статусов, удаление)
    match /residents/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Запрет доступа к любым непредусмотренным коллекциям
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

