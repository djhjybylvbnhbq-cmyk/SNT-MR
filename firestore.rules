rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /residents/{residentId} {
      allow read: if true;
      allow create, update: if isValidId(residentId) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 200;
      allow delete: if isValidId(residentId);
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 4000;
      allow update, delete: if isValidId(messageId);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300;
      allow delete: if isValidId(announcementId);
    }

    match /config/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId);
      allow delete: if false;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
